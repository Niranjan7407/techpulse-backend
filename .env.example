# PostgreSQL. Keep credentials private; do not commit .env.local.
DB_URL=postgresql://postgres:password@localhost:5432/techpulse

# Gemini key used by Crawl4AI extraction plus one additional briefing request per crawl run.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini/gemini-3.5-flash-lite

# Required to enable protected admin endpoints.
ADMIN_API_KEY=replace_with_a_long_random_secret

# Comma-separated Next.js origin(s); default development frontend.
FRONTEND_ORIGIN=http://localhost:3000
PORT=8000
